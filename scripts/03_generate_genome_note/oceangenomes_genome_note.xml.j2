  <!-- ============================================================
       FRONT MATTER
       ============================================================ -->
  <front>
    <journal-meta>
      <journal-id journal-id-type="pmc">Wellcome Open Res</journal-id>
      <journal-title-group>
        <journal-title>Wellcome Open Research</journal-title>
      </journal-title-group>
      <issn pub-type="epub">2398-502X</issn>
      <publisher>
        <publisher-name>F1000 Research Limited</publisher-name>
        <publisher-loc>London, UK</publisher-loc>
      </publisher>
    </journal-meta>

    <article-meta>
      <article-id pub-id-type="doi">{{ doi }}</article-id>

      <article-categories>
        <subj-group subj-group-type="heading">
          <subject>Data Note</subject>
        </subj-group>
        <subj-group>
          <subject>Articles</subject>
        </subj-group>
      </article-categories>

      <title-group>
        <article-title>The genome sequence of the {{ common_name }},
          <italic>{{ species_name }}</italic> ({{ authority }})
        </article-title>
        <fn-group content-type="pub-status">
          <fn>
            <p>[version 1; peer review: awaiting peer review]</p>
          </fn>
        </fn-group>
      </title-group>

      <!-- ── Authors ── -->
      <contrib-group>
        <!-- Named collector(s) -->
        {% for collector in collectors %}
        <contrib contrib-type="author" corresp="no">
          <name>
            <surname>{{ collector.surname }}</surname>
            <given-names>{{ collector.given_names }}</given-names>
          </name>
          <role content-type="http://credit.niso.org/">Investigation</role>
          <role content-type="http://credit.niso.org/">Resources</role>
          {% if collector.orcid %}<uri content-type="orcid">{{ collector.orcid }}</uri>{% endif %}
          <xref ref-type="aff" rid="a{{ collector.aff_num }}">{{ collector.aff_num }}</xref>
        </contrib>
        {% endfor %}

        <!-- Background / intro writer -->
        {% for writer in intro_writers %}
        <contrib contrib-type="author" corresp="no">
          <name>
            <surname>{{ writer.surname }}</surname>
            <given-names>{{ writer.given_names }}</given-names>
          </name>
          <role content-type="http://credit.niso.org/">Writing &#x2013; Original Draft Preparation</role>
          {% if writer.orcid %}<uri content-type="orcid">{{ writer.orcid }}</uri>{% endif %}
          <xref ref-type="aff" rid="a{{ writer.aff_num }}">{{ writer.aff_num }}</xref>
        </contrib>
        {% endfor %}

        <!-- Genome curator -->
        {% for curator in curators %}
        <contrib contrib-type="author" corresp="no">
          <name>
            <surname>{{ curator.surname }}</surname>
            <given-names>{{ curator.given_names }}</given-names>
          </name>
          <role content-type="http://credit.niso.org/">Data Curation</role>
          <role content-type="http://credit.niso.org/">Writing &#x2013; Review &amp; Editing</role>
          {% if curator.orcid %}<uri content-type="orcid">{{ curator.orcid }}</uri>{% endif %}
          <xref ref-type="aff" rid="a{{ curator.aff_num }}">{{ curator.aff_num }}</xref>
        </contrib>
        {% endfor %}

        <!-- OceanOmics Centre contributors -->
        {% for contributor in contributors %}
        <contrib contrib-type="author" corresp="no">
          <name>
            <surname>{{ contributor.surname }}</surname>
            <given-names>{{ contributor.given_names }}</given-names>
          </name>
          <role content-type="http://credit.niso.org/">Methodology</role>
          <role content-type="http://credit.niso.org/">Writing &#x2013; Review &amp; Editing</role>
          {% if contributor.orcid %}<uri content-type="orcid">{{ contributor.orcid }}</uri>{% endif %}
          <xref ref-type="aff" rid="a{{ contributor.aff_num }}">{{ contributor.aff_num }}</xref>
        </contrib>
        {% endfor %}

        <!-- OceanOmics Division — listed as a collab group; members expanded in Author information -->
        {% if oceanomics_division %}
        <contrib contrib-type="author" corresp="no">
          <collab>OceanOmics Division</collab>
        </contrib>
        {% endif %}

        <!-- Affiliations (deduplicated — identical addresses share one entry) -->
        {% for aff in unique_affs %}
        <aff id="{{ aff.id }}">
          <label>{{ aff.label }}</label>{{ aff.text }}
        </aff>
        {% endfor %}
